# ==============================================================================
# JobHunt Environment Configuration
# ==============================================================================

# Database Connection
# When running with Docker Compose, 'db' is the hostname of the postgres container.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/jobhunt
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@db:5432/jobhunt

# Telegram Bot Notifications (Optional)
# If provided, high-signal matching job alerts and first-launch welcome batches
# will be delivered directly to your Telegram chat.
# 1. Message @BotFather on Telegram to create a new bot and copy the bot token.
# 2. Message @userinfobot to retrieve your Telegram user / chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notification toggle (true/false)
NOTIFY_ENABLED=true

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

